[Unit]
Description=Davida Core VPN Management API & Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vpn-panel
ExecStart=/usr/bin/python3 /opt/vpn-panel/davida_core.py
Restart=always
RestartSec=3
# NOTE: no NoNewPrivileges here on purpose — the panel performs user management
# through `sudo /usr/local/bin/... deluser|sync`, and NoNewPrivileges blocks sudo.
ProtectSystem=full
PrivateTmp=yes
# The panel must write the Xray client list when users are added/removed.
ReadWritePaths=/etc/vpn-cluster /opt/vpn-panel /usr/local/etc/xray

[Install]
WantedBy=multi-user.target
